set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{GNU_ARM_ROOT})
    message(FATAL_ERROR "GNU_ARM_ROOT must name the extracted Ubuntu toolchain root")
endif()
set(ARM_ROOT "$ENV{GNU_ARM_ROOT}")
set(CMAKE_C_COMPILER "${ARM_ROOT}/usr/bin/arm-none-eabi-gcc")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${ARM_ROOT}/usr/bin/arm-none-eabi-ar")
set(CMAKE_RANLIB "${ARM_ROOT}/usr/bin/arm-none-eabi-ranlib")
set(CMAKE_OBJCOPY "${ARM_ROOT}/usr/bin/arm-none-eabi-objcopy")
set(CMAKE_SIZE "${ARM_ROOT}/usr/bin/arm-none-eabi-size")
set(NEWLIB "${ARM_ROOT}/usr/lib/arm-none-eabi/newlib/thumb/v6-m/nofp")
set(CMAKE_C_FLAGS_INIT "-isystem ${ARM_ROOT}/usr/include/newlib -B${NEWLIB}/")
set(CMAKE_ASM_FLAGS_INIT "-isystem ${ARM_ROOT}/usr/include/newlib -B${NEWLIB}/")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${NEWLIB}")
