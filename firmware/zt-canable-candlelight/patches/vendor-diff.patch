+void USBD_GS_CAN_StopSession(USBD_HandleTypeDef *pdev)
+{
+	USBD_GS_CAN_HandleTypeDef *hcan = (USBD_GS_CAN_HandleTypeDef*)pdev->pClassData;
+	if (!hcan) return;
+	int primask = disable_irq();
+	hcan->can_running = false;
+	for (unsigned i = 0; i < NUM_CAN_CHANNEL; ++i)
+		if (hcan->channels[i]) can_disable(hcan->channels[i]);
+	void *frame;
+	while ((frame = queue_pop_front_i(hcan->q_from_host)) != NULL)
+		queue_push_back_i(hcan->q_frame_pool, frame);
+	while ((frame = queue_pop_front_i(hcan->q_to_host)) != NULL)
+		queue_push_back_i(hcan->q_frame_pool, frame);
+	if (hcan->leds) led_set_mode(hcan->leds, led_mode_off);
+	enable_irq(primask);
+}
